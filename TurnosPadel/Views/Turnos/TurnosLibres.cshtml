@model IEnumerable<TurnosPadel.Models.Turno>

@{
    ViewData["Title"] = "Turnos Libres";
}

<h2>Turnos Libres</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<p>
    <b>Tener en cuenta que si reserva un turno fijo será para todas las semanas, si usted un día no asiste sin previo aviso de 12hs, deberá abonar el valor del turno.</b>
</p>

<form asp-action="TurnosLibres" method="get" class="mb-3">
    <label for="fechaSeleccionada">Seleccioná una fecha:</label>
    <input type="date" name="fechaSeleccionada" class="form-control"
           value="@ViewBag.FechaSeleccionada" style="max-width: 200px; display: inline-block; margin-right: 10px;" />
    <button type="submit" class="btn btn-primary btn-sm">Filtrar</button>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Cancha</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var turno in Model)
            {
                <tr>
                    <td>@turno.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@turno.HoraInicio.ToString(@"hh\:mm")</td>
                    <td>@turno.Cancha</td>
                    <td>
                        <form asp-controller="Turnos" asp-action="Reservar" asp-route-id="@turno.Id" method="post" style="display:inline-block;">
                            @Html.AntiForgeryToken()

                            <button type="submit" name="esFijo" value="false" class="btn btn-success btn-sm">Reservar</button>
                            <button type="submit" name="esFijo" value="true" class="btn btn-info btn-sm">Reservar fijo</button>
                        </form>

                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">No hay turnos disponibles.</td>
            </tr>
        }
    </tbody>
</table>

