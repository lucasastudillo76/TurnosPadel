@model IEnumerable<TurnosPadel.Models.Turno>

@{
    ViewData["Title"] = "Mis Turnos";
}

<h2>Mis Turnos</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Cancha</th>
            <th>Fijo</th>
            <th>Pago</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var turno in Model)
        {
            <tr>
                <td>@turno.Fecha.ToShortDateString()</td>
                <td>@turno.HoraInicio</td>
                <td>@turno.Cancha</td>
                <td>@(turno.EsFijo ? "Sí" : "No")</td>
                <td>
                    @if (turno.EstaPagado)
                    {
                        <span class="badge bg-success">Pagado</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Pendiente</span>
                    }
                </td>
                <td>
                    @if (turno.EsFijo)
                    {
                        <form asp-controller="Turnos" asp-action="CancelarFijo" asp-route-id="@turno.Id" method="post" style="display:inline-block;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-sm">Cancelar fijo</button>
                        </form>
                    }

                    <form asp-controller="Turnos" asp-action="CancelarPorHoy" asp-route-id="@turno.Id" method="post" style="display:inline-block;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning btn-sm mt-1">Cancelar por hoy</button>
                    </form>

                    @if (!turno.EstaPagado)
                    {
                        <a href="@Url.Action("CrearPago", "Pago", new { turnoId = turno.Id })"
                           class="btn btn-primary btn-sm mt-1">
                            Pagar con Mercado Pago
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
