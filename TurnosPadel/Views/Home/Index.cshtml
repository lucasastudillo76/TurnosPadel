@{
    ViewData["Title"] = "Bienvenido a Club Deportivo y Cultural La Francia";
}

<section class="banner">
    <div class="container">
        <h1>Bienvenido a Club Deportivo y Cultural La Francia</h1>
        <p>Tu lugar para disfrutar de deportes y bienestar.</p>
        <img src="~/images/fotoentrada.png" alt="Imagen del Club" class="img-fluid" /> 
    </div>
</section>

<br />
<br />
<br />
<br />
<br />

<h2>Disciplinas</h2>

<div id="disciplinasCarrusel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="2500">
    <div class="carousel-inner">
        @for (int i = 0; i < ((List<(string nombre, string imagen)>)ViewData["Disciplinas"]).Count; i++)
        {
            var disciplina = ((List<(string nombre, string imagen)>)ViewData["Disciplinas"])[i];
            <div class="carousel-item @(i == 0 ? "active" : "")">
                <img src="~/images/@disciplina.imagen" class="d-block w-100" alt="Imagen de @disciplina.nombre" />
                <div class="carousel-caption d-none d-md-block">
                    <h5>@disciplina.nombre</h5>
                </div>
            </div>
        }
    </div>
</div>

<div class="text-center mt-4">
    <a href="@Url.Action("TurnosLibres", "Turnos")" class="btn btn-primary">Ver Turnos Libres de Padel</a>
</div>
